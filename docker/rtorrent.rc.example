#############################################################################
# rtorrent.rc tuned for running inside the Docker image shipped in this repo.
#
# Mount this file at /config/rtorrent.rc (read-only is fine).
# See https://github.com/rakshasa/rtorrent/wiki/CONFIG-Template for a full
# reference, and https://rtorrent-docs.readthedocs.io/ for command details.
#############################################################################

# --- Paths -----------------------------------------------------------------
# These are the in-container paths. Map them to host directories via the
# "volumes:" block in docker-compose.yml.
method.insert = cfg.basedir,  private|const|string, "/data/"
method.insert = cfg.download, private|const|string, (cat,(cfg.basedir),"download/")
method.insert = cfg.session,  private|const|string, (cat,(cfg.basedir),"session/")
method.insert = cfg.watch,    private|const|string, (cat,(cfg.basedir),"watch/")

session.path.set     = (cat,(cfg.session))
directory.default.set = (cat,(cfg.download))

# Watch dirs (drop *.torrent files into ./data/watch/{load,start} on the host).
schedule2 = watch_load,  10, 10, ((load.verbose,       (cat,(cfg.watch),"load/*.torrent")))
schedule2 = watch_start, 11, 10, ((load.start_verbose, (cat,(cfg.watch),"start/*.torrent")))

# --- Networking ------------------------------------------------------------
# Single fixed peer port — must match the "ports:" block in compose.
network.port_range.set  = 6881-6881
network.port_random.set = no

# DHT / PEX / UDP trackers (turn on for public swarms; off for private trackers).
dht.mode.set        = auto
dht.port.set        = 6881
protocol.pex.set    = yes
trackers.use_udp.set = yes

protocol.encryption.set = allow_incoming,try_outgoing,enable_retry

# --- Daemon mode + RPC -----------------------------------------------------
# Daemon mode disables ncurses so rtorrent can run as a Docker PID 1 with no TTY.
system.daemon.set = true

# SCGI/XMLRPC listener. 0.0.0.0 here is fine because the host-side compose
# binding is 127.0.0.1 by default — SCGI itself has NO auth.
network.scgi.open_port = 0.0.0.0:5000
network.rpc.use_xmlrpc.set = true

# --- Resource limits -------------------------------------------------------
throttle.max_uploads.set        = 100
throttle.max_uploads.global.set = 250
throttle.min_peers.normal.set   = 20
throttle.max_peers.normal.set   = 60
throttle.min_peers.seed.set     = 30
throttle.max_peers.seed.set     = 80
trackers.numwant.set            = 80

network.http.max_open.set       = 50
network.max_open_files.set      = 600
network.max_open_sockets.set    = 300
pieces.memory.max.set           = 1024M
network.xmlrpc.size_limit.set   = 4M

# --- Misc ------------------------------------------------------------------
encoding.add        = utf8
system.umask.set    = 0027
system.cwd.set      = (directory.default)
schedule2 = monitor_diskspace, 15, 60, ((close_low_diskspace, 1000M))

### END ###
