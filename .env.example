# Copy to `.env` and edit. Values here mirror the defaults baked into
# docker-compose.yml, so an empty .env is equivalent to no .env at all.

# BitTorrent peer / DHT listen port (TCP+UDP).
# Must match `network.port_range.set` in rtorrent.rc.
RTORRENT_BT_PORT=6881

# Host path to rtorrent.rc, mounted read-only into the container.
# Relative paths are resolved from the docker-compose.yml directory.
# Use an absolute path or ${HOME}/... — `~` is not expanded inside .env values.
RTORRENT_CONFIG_FILE=./config/rtorrent.rc

# Host directory containing session/, watch/, download/, log/ subdirs.
# Each subdir is mounted into /data/<name> in the container.
RTORRENT_DATA_DIR=./data
